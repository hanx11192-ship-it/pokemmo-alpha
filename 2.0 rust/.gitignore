# 构建产物
/target
**/*.rs.bk

# 运行时状态（去重标记等，每台机器不同）
/data/state.json
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# 日志
/logs
*.log

# 环境变量：里面是 token / key，绝不入库
# （仅锚定仓库根；1.0python/ 历史归档里的同名示例文件保留）
/.env
/panel.env

# 现网数据库副本：含真实用户密码哈希与推送 token，只放在仓库外
*.db
*.db.bak.*
live_fixtures/

# 编辑器
.idea/
.vscode/
*.swp

# 现网 users 表记录（真实密码哈希）——只在做安全审计的本机存在，
# 测试代码在缺这个文件时会退化成一条合成哈希。
crates/alpha-server/tests/fixtures/live_user.json
