// ═══════════════════════════════════════════════════════════════════════════
//  默认决策器 / Default Dispatcher
// ═══════════════════════════════════════════════════════════════════════════
//
// @name 默认决策器
// @description 内置：基于 alpha-strategy 的官方打法引擎
// @version 2.0
//
// ── 这是什么 ──────────────────────────────────────────────────────────────
//
// 面板的默认决策器：直接输出官方打法引擎生成的报告，不加任何东西。
//
// ── 分发器契约 ────────────────────────────────────────────────────────────
//
//     fn dispatch(boss, ctx) -> String
//
//     boss —— 归一化后的头目（只读 map），常用字段：
//         boss.name        中文名
//         boss.ability     特性
//         boss.moves       技能列表（中文名）
//         boss.move_ids    技能 id 列表（解析不出的位置是 `()`）
//         boss.location    地点
//         boss.period      时段，如 "14:30~15:45"
//         boss.gender      性别比例，如 "50.0%公"
//         boss.egg_groups  蛋组
//         boss.pokedex_id  全国图鉴号（可能为 `()`）
//         boss.extra_lines 源给的附加信息（秘传机、地点备注…）
//
//     ctx —— 上下文：
//         ctx.lang        当前语言，"zh" 或 "en"
//         ctx.langs       输出语言列表，双语模式是 ["zh","en"]
//         ctx.bilingual   是否双语模式
//
//     返回 —— 一段可直接推送 / 展示的文本
//
//     可用函数（全部只读，沙箱内没有文件/网络/进程访问）：
//         resolve_move_id(名字)      -> id 或 ()
//         resolve_pokemon_id(名字)   -> id 或 ()
//         resolve_ability_id(名字)   -> id 或 ()
//         move_name(id, lang)        -> 规范名
//         pokemon_name(id, lang)     -> 规范名
//         ability_name(id, lang)     -> 规范名
//         engine_report(boss, ctx)   -> 官方引擎报告文本
//
// ── 想自己改？ ────────────────────────────────────────────────────────────
//
// 复制这个文件，改个名字，在 `dispatch` 里按需要加工 `engine_report` 的结果。
// 面板 → 决策器 → 上传，然后在列表里「设为当前」即可。
//
// 改坏了不会炸：分发器抛异常时面板会回退到引擎默认输出，
// 并在日志里记一条 error，不会中断轮询。
// ═══════════════════════════════════════════════════════════════════════════

fn dispatch(boss, ctx) {
    // 官方引擎已经是完整实现，这里直接转发。
    //
    // 评估行由调度器通过 `with_evaluator` 注入的钩子自动带上（如果
    // 有激活的评估器），分发器不需要关心 —— 保持「决策器」与「评估器」
    // 两个维度完全正交，换决策器不必换评估器，反之亦然。
    engine_report(boss, ctx)
}
